+TEST_BEGIN(FCSEL_D_FLOATSEL, fcsel_d, 2)
+TEST_INPUTS(
+    0, 0,
+    0, 1,
+    1, 0,
+    0x8000000000000000, 1,
+    0x7fffffffffffffff, 0x8000000000000000)
+    cmp ARG1_64, ARG2_64
+    fcsel d0, d1, d2, eq
+    fcsel d3, d4, d5, ne
+    fcsel d6, d7, d8, mi
+    fcsel d9, d10, d11, gt
