+TEST_INPUTS(
+    0, 0,
+    0, 1,
+    1, 0,
+    0x80000000, 1,
+    0x7fffffff, 0x80000000)
+    cmp ARG1_32, ARG2_32
+    fcsel s0, s1, s2, eq
+    fcsel s3, s4, s5, ne
+    fcsel s6, s7, s8, mi
+    fcsel s9, s10, s11, gt
+    fcsel s12, s13, s14, lo
+    fcsel s15, s16, s17, vs
+TEST_END
