From 077336deaf193b7d1b4c82ed8a36834b56f65e9c Mon Sep 17 00:00:00 2001
From: veritr1x <9086448+veritr1x@users.noreply.github.com>
Date: Sun, 25 Oct 2026 13:34:11 +0530
Subject: [PATCH 1/3] AArch64: track FPSR.DZC; tests: save and restore DZC,
 write FPSR (not FPCR)

The test harness never saved or restored the divide-by-zero flag, and wrote
the synced FPSR value into FPCR, where the cumulative flags land on control
bits (FIZ, AH, NEP with FEAT_AFP). MRS and MSR FPSR also dropped DZC. The
byte-difference report now prints both values.
---
 generated/Arch/AArch64/RestoreState.S |  4 +++-
 generated/Arch/AArch64/SaveState.S    |  2 ++
 lib/Arch/AArch64/Semantics/SYSTEM.cpp |  2 ++
 tests/AArch64/PrintRestoreState.cpp   | 11 +++++++++--
 tests/AArch64/PrintSaveState.cpp      |  4 ++++
 tests/AArch64/Run.cpp                 |  4 +++-
 6 files changed, 23 insertions(+), 4 deletions(-)

diff --git a/generated/Arch/AArch64/RestoreState.S b/generated/Arch/AArch64/RestoreState.S
index 41f734c..9eccf3d 100644
--- a/generated/Arch/AArch64/RestoreState.S
+++ b/generated/Arch/AArch64/RestoreState.S
@@ -15,6 +15,8 @@ ldr x1, [x28, #1080]
 ldr x1, [x28, #1088]
 ldrb w2, [x28, #1153]
 bfi x1, x2, #0, #1
+ldrb w2, [x28, #1155]
+bfi x1, x2, #1, #1
 ldrb w2, [x28, #1147]
 bfi x1, x2, #2, #1
 ldrb w2, [x28, #1149]
@@ -24,7 +26,7 @@ bfi x1, x2, #4, #1
 ldrb w2, [x28, #1151]
 bfi x1, x2, #6, #1
 str x1, [x28, #1088]
-msr fpcr, x1
+msr fpsr, x1
 ldr x1, [x28, #1112]
 msr tpidr_el0, x1
 add x1, x28, #16
diff --git a/generated/Arch/AArch64/SaveState.S b/generated/Arch/AArch64/SaveState.S
index 51b516b..89fea9f 100644
--- a/generated/Arch/AArch64/SaveState.S
+++ b/generated/Arch/AArch64/SaveState.S
@@ -57,6 +57,8 @@ mrs x1, fpsr
 str x1, [x28, #1088]
 ubfx x29, x1, #0, #1
 strb w29, [x28, #1153]
+ubfx x29, x1, #1, #1
+strb w29, [x28, #1155]
 ubfx x29, x1, #2, #1
 strb w29, [x28, #1147]
 ubfx x29, x1, #3, #1
diff --git a/lib/Arch/AArch64/Semantics/SYSTEM.cpp b/lib/Arch/AArch64/Semantics/SYSTEM.cpp
index 82ba1b0..8c019d2 100644
--- a/lib/Arch/AArch64/Semantics/SYSTEM.cpp
+++ b/lib/Arch/AArch64/Semantics/SYSTEM.cpp
@@ -36,6 +36,7 @@ DEF_SEM(DoMRS_RS_SYSTEM_FPSR, R64W dest) {
 
   //fpsr.idc = state.sr.idc;  // TODO(garret): fix the saving of the idc bit before reenabling (issue #188)
   fpsr.ioc = state.sr.ioc;
+  fpsr.dzc = state.sr.dzc;
   WriteZExt(dest, fpsr.flat);
   return memory;
 }
@@ -47,6 +48,7 @@ DEF_SEM(DoMSR_SR_SYSTEM_FPSR, R64 src) {
   fpsr._res1 = 0;
   state.fpsr = fpsr;
   state.sr.ioc = fpsr.ioc;
+  state.sr.dzc = fpsr.dzc;
   state.sr.ofc = fpsr.ofc;
   state.sr.ixc = fpsr.ixc;
   state.sr.ufc = fpsr.ufc;
diff --git a/tests/AArch64/PrintRestoreState.cpp b/tests/AArch64/PrintRestoreState.cpp
index 43ee0d2..d9a4306 100644
--- a/tests/AArch64/PrintRestoreState.cpp
+++ b/tests/AArch64/PrintRestoreState.cpp
@@ -54,6 +54,10 @@ int main(void) {
   printf("ldrb w2, [x28, #%lu]\n", offsetof(State, sr.ioc));
   printf("bfi x1, x2, #0, #1\n");
 
+  // Extract the cumulative divide by zero flag from the SR into the FPSR.
+  printf("ldrb w2, [x28, #%lu]\n", offsetof(State, sr.dzc));
+  printf("bfi x1, x2, #1, #1\n");
+
   // Extract the cumulative overflow flag from the SR into the FPSR.
   printf("ldrb w2, [x28, #%lu]\n", offsetof(State, sr.ofc));
   printf("bfi x1, x2, #2, #1\n");
@@ -70,9 +74,12 @@ int main(void) {
   printf("ldrb w2, [x28, #%lu]\n", offsetof(State, sr.idc));
   printf("bfi x1, x2, #6, #1\n");
 
-  // Sync `fpsr` between native and lifted.
+  // Sync `fpsr` between native and lifted. This used to be written to FPCR,
+  // which put the cumulative flags into FPCR's control bits (with FEAT_AFP,
+  // bits 0-2 are FIZ, AH and NEP) and never restored FPSR. FPCR keeps the
+  // host's default, which is also what the lifted code runs under.
   printf("str x1, [x28, #%lu]\n", offsetof(State, fpsr));
-  printf("msr fpcr, x1\n");
+  printf("msr fpsr, x1\n");
 
   // User-space thread pointer register.
   printf("ldr x1, [x28, #%lu]\n", offsetof(State, sr.tpidr_el0));
diff --git a/tests/AArch64/PrintSaveState.cpp b/tests/AArch64/PrintSaveState.cpp
index 53b1044..eb19bb2 100644
--- a/tests/AArch64/PrintSaveState.cpp
+++ b/tests/AArch64/PrintSaveState.cpp
@@ -105,6 +105,10 @@ int main(void) {
   printf("ubfx x29, x1, #0, #1\n");
   printf("strb w29, [x28, #%lu]\n", offsetof(State, sr.ioc));
 
+  // Save the cumulative divide by zero flag from the FPSR into the SR.
+  printf("ubfx x29, x1, #1, #1\n");
+  printf("strb w29, [x28, #%lu]\n", offsetof(State, sr.dzc));
+
   // Save the cumulative overflow flag from the FPSR into the SR.
   printf("ubfx x29, x1, #2, #1\n");
   printf("strb w29, [x28, #%lu]\n", offsetof(State, sr.ofc));
diff --git a/tests/AArch64/Run.cpp b/tests/AArch64/Run.cpp
index e150d4c..d6cd1eb 100644
--- a/tests/AArch64/Run.cpp
+++ b/tests/AArch64/Run.cpp
@@ -843,7 +843,9 @@ static void RunWithFlags(const test::TestInfo *info, NZCV flags,
 
     for (size_t i = 0; i < sizeof(State); ++i) {
       LOG_IF(ERROR, lifted_state_bytes[i] != native_state_bytes[i])
-          << "Bytes at offset " << i << " are different";
+          << "Bytes at offset " << i << " are different: lifted "
+          << static_cast<int>(lifted_state_bytes[i]) << ", native "
+          << static_cast<int>(native_state_bytes[i]);
     }
   }
 
