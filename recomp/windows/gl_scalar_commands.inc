// Scalar-only GLES state/clear commands. No guest pointer or mapped lifetime.
// Signatures follow Khronos GLES3/gl32.h; keep entries append-only for markers.
GL_SCALAR(glActiveTexture, PFNGLACTIVETEXTUREPROC, void(GLenum))
GL_SCALAR(glEnable, PFNGLENABLEPROC, void(GLenum))
GL_SCALAR(glDisable, PFNGLDISABLEPROC, void(GLenum))
GL_SCALAR(glIsEnabled, PFNGLISENABLEDPROC, GLboolean(GLenum))
GL_SCALAR(glViewport, PFNGLVIEWPORTPROC, void(GLint, GLint, GLsizei, GLsizei))
GL_SCALAR(glScissor, PFNGLSCISSORPROC, void(GLint, GLint, GLsizei, GLsizei))
GL_SCALAR(glClearColor, PFNGLCLEARCOLORPROC, void(GLfloat, GLfloat, GLfloat, GLfloat))
GL_SCALAR(glClearDepthf, PFNGLCLEARDEPTHFPROC, void(GLfloat))
GL_SCALAR(glClearStencil, PFNGLCLEARSTENCILPROC, void(GLint))
GL_SCALAR(glClear, PFNGLCLEARPROC, void(GLbitfield))
GL_SCALAR(glColorMask, PFNGLCOLORMASKPROC, void(GLboolean, GLboolean, GLboolean, GLboolean))
GL_SCALAR(glDepthMask, PFNGLDEPTHMASKPROC, void(GLboolean))
GL_SCALAR(glDepthFunc, PFNGLDEPTHFUNCPROC, void(GLenum))
GL_SCALAR(glDepthRangef, PFNGLDEPTHRANGEFPROC, void(GLfloat, GLfloat))
GL_SCALAR(glStencilMaskSeparate, PFNGLSTENCILMASKSEPARATEPROC, void(GLenum, GLuint))
GL_SCALAR(glStencilFuncSeparate, PFNGLSTENCILFUNCSEPARATEPROC, void(GLenum, GLenum, GLint, GLuint))
GL_SCALAR(glStencilOpSeparate, PFNGLSTENCILOPSEPARATEPROC, void(GLenum, GLenum, GLenum, GLenum))
GL_SCALAR(glBlendColor, PFNGLBLENDCOLORPROC, void(GLfloat, GLfloat, GLfloat, GLfloat))
GL_SCALAR(glBlendEquationSeparate, PFNGLBLENDEQUATIONSEPARATEPROC, void(GLenum, GLenum))
GL_SCALAR(glBlendFuncSeparate, PFNGLBLENDFUNCSEPARATEPROC, void(GLenum, GLenum, GLenum, GLenum))
GL_SCALAR(glCullFace, PFNGLCULLFACEPROC, void(GLenum))
GL_SCALAR(glFrontFace, PFNGLFRONTFACEPROC, void(GLenum))
GL_SCALAR(glPolygonOffset, PFNGLPOLYGONOFFSETPROC, void(GLfloat, GLfloat))
GL_SCALAR(glSampleCoverage, PFNGLSAMPLECOVERAGEPROC, void(GLfloat, GLboolean))
GL_SCALAR(glLineWidth, PFNGLLINEWIDTHPROC, void(GLfloat))
GL_SCALAR(glHint, PFNGLHINTPROC, void(GLenum, GLenum))
GL_SCALAR(glFlush, PFNGLFLUSHPROC, void())
GL_SCALAR(glFinish, PFNGLFINISHPROC, void())
