# x86_64 side: Remill (lifter, clang 11, AArch64 semantics) plus a C/C++ toolchain to link the result.
FROM --platform=linux/amd64 trailofbits/remill:llvm1100-ubuntu20.04-amd64
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
ENTRYPOINT []
