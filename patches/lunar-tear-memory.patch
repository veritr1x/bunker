+
+// read decrypts the bytes [off, off+n) of the decrypted file. In CBC each block
+// is decrypted with the ciphertext block before it, so any range can be read alone.
+func (f *tableFile) read(off, n int) ([]byte, error) {
+	first := off / aes.BlockSize
+	end := (off + n + aes.BlockSize - 1) / aes.BlockSize
+	start := first - 1 // the block before is the IV; the first block's is the file's
+	if start < 0 {
+		start = 0
+	}
+	buf := make([]byte, (end-start)*aes.BlockSize)
+	if _, err := f.file.ReadAt(buf, int64(start*aes.BlockSize)); err != nil {
+		return nil, err
+	}
+	iv, err := hex.DecodeString(aesIVHex)
+	if err != nil {
+		return nil, err
+	}
+	if first > 0 {
+		iv, buf = buf[:aes.BlockSize], buf[aes.BlockSize:]
+	}
+	key, err := hex.DecodeString(aesKeyHex)
+	if err != nil {
+		return nil, err
+	}
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+	cipher.NewCBCDecrypter(block, iv).CryptBlocks(buf, buf)
+	skip := off - first*aes.BlockSize
+	return buf[skip : skip+n], nil
+}
