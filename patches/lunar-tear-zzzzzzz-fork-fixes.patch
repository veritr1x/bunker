+// gimmickSequenceWriter writes one sequence row without loading the save
+// (sqlite.SQLiteStore.EnsureGimmickSequence).
+type gimmickSequenceWriter interface {
+	EnsureGimmickSequence(userId int64, scheduleId, sequenceId int32, maxRows int) (added, ok bool, err error)
+}
+
+// ensureGimmickSequence adds the sequence row if the save lacks it and returns
+// the game's diff for it (none when it was there). The game sends
+// UpdateSequence for each sequence while a map loads, dozens at a time; going
+// through UpdateUser and the diff and mission interceptors loaded the whole
+// save about five times per call. Only a save at the row cap, or a store
+// without the one-row write, takes the full update. From the
+// JCalandre/lunar-tear fork; the interceptors skip this method
+// (handlerDiffsItself).
+func ensureGimmickSequence(users store.UserRepository, userId int64, key store.GimmickSequenceKey) (map[string]*pb.DiffData, error) {
+	const table = "IUserGimmickSequence"
+	if w, ok := users.(gimmickSequenceWriter); ok {
+		added, ok, err := w.EnsureGimmickSequence(userId, key.GimmickSequenceScheduleId, key.GimmickSequenceId, masterdata.MaxUserGimmickRows)
+		if err != nil {
+			return nil, err
 		}
+		if ok {
+			if !added {
+				return nil, nil
+			}
+			before := store.UserState{UserId: userId, Gimmick: store.GimmickState{Sequences: map[store.GimmickSequenceKey]store.GimmickSequenceState{}}}
+			after := before
+			after.Gimmick.Sequences = map[store.GimmickSequenceKey]store.GimmickSequenceState{key: {Key: key}}
+			return userdata.ComputeDelta(&before, &after, []string{table}), nil
+		}
+	}
+	var before store.UserState
+	after, err := users.UpdateUser(userId, func(user *store.UserState) {
+		before = store.CloneUserState(*user)
 		sequence := user.Gimmick.Sequences[key]
 		sequence.Key = key
 		user.Gimmick.Sequences[key] = sequence
 	})
-	return &pb.UpdateSequenceResponse{}, nil
+	if err != nil {
+		return nil, err
+	}
+	if !slices.Contains(userdata.ChangedTables(&before, &after), table) {
+		return nil, nil
+	}
+	return userdata.ComputeDelta(&before, &after, []string{table}), nil
 }
 
