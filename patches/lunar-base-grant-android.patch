+// Execute runs the upstream grant protocol in-process, without a child executable.
+func Execute(raw []byte) (result string) {
+	defer func() {
+		if caught := recover(); caught != nil {
+			encoded, _ := json.Marshal(response{OK: false, Error: fmt.Sprint(caught)})
+			result = string(encoded)
+		}
+	}()
+	applied, err := run(raw)
+	reply := response{OK: err == nil, Applied: applied}
+	if err != nil {
+		reply.Error = err.Error()
+	}
+	encoded, _ := json.Marshal(reply)
+	return string(encoded)
+}
