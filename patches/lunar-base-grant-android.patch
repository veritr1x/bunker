+// Check the complete batch before writing. Repeated large grants must not wrap
+// the game's signed 32-bit quantities into negative inventory balances.
+func validateStackable(user *store.UserState, grants []grantSpec) error {
+	totals := make(map[[2]int32]int64)
+	for _, g := range grants {
+		if g.Count <= 0 {
+			return errors.New("grant count must be positive")
+		}
+		key := [2]int32{g.PossessionType, g.PossessionID}
+		if g.PossessionType == 11 || g.PossessionType == 12 {
+			key[1] = 0 // Gems have one balance, regardless of supplied item ID.
+		}
+		value, exists := totals[key]
+		if !exists {
+			switch model.PossessionType(g.PossessionType) {
+			case model.PossessionTypeMaterial:
+				value = int64(user.Materials[g.PossessionID])
+			case model.PossessionTypeConsumableItem:
+				value = int64(user.ConsumableItems[g.PossessionID])
+			case model.PossessionTypePaidGem:
+				value = int64(user.Gem.PaidGem)
+			case model.PossessionTypeFreeGem:
+				value = int64(user.Gem.FreeGem)
+			case model.PossessionTypeImportantItem:
+				value = int64(user.ImportantItems[g.PossessionID])
+			default:
+				return errors.New("unsupported stackable item type")
+			}
+		}
+		value += int64(g.Count)
+		if value > 2147483647 {
+			return errors.New("grant would exceed the game's inventory limit")
+		}
+		totals[key] = value
+	}
+	paid, paidChanged := totals[[2]int32{int32(model.PossessionTypePaidGem), 0}]
+	free, freeChanged := totals[[2]int32{int32(model.PossessionTypeFreeGem), 0}]
+	if !paidChanged {
+		paid = int64(user.Gem.PaidGem)
+	}
+	if !freeChanged {
+		free = int64(user.Gem.FreeGem)
+	}
+	if (paidChanged || freeChanged) && paid+free > 2147483647 {
+		return errors.New("grant would exceed the game's inventory limit")
+	}
+	return nil
 }
 
