<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Bunker installs its own updates (Updater.java); Android asks the player each time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Only for "use in place": the player turns it on in Settings to keep the game files in their own folder. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <queries><package android:name="com.square_enix.android_googleplay.nierspww" /></queries>
    <application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="Lunar Tear"
        android:allowBackup="false" android:usesCleartextTraffic="true" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:process=":lunar_server" android:exported="true" android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The Archive gets a process of its own, ended when it closes: Python, WebView and the picture
             converters would otherwise stay in the server's memory for the rest of the game. -->
        <activity android:name=".ArchiveActivity" android:process=":archive" android:exported="false" android:resizeableActivity="true" android:enableOnBackInvokedCallback="true" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />
        <!-- Ends the server's process after Pod Programs and reopens the launcher in a fresh one (RestartActivity.java). -->
        <activity android:name=".RestartActivity" android:process=":restart" android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true" android:noHistory="true" />
        <activity android:name=".ToolsActivity" android:process=":lunar_server" android:exported="false" android:resizeableActivity="true" android:enableOnBackInvokedCallback="true" />
        <!-- Runs in the game's process at start: loopback requests skip any phone proxy (VPN apps), and a game
             opened without its server (for example from Recent apps) goes through the launcher instead. -->
        <provider android:name=".GameProcessProvider" android:authorities="${applicationId}.lunar_loopback" android:exported="false" />
        <service android:name=".ServerService" android:process=":lunar_server" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started offline game preservation server. Serves local game requests and assets on loopback while the user plays in another app; also imports user-selected local game files. Stops on user request." />
        </service>
    </application>
</manifest>
