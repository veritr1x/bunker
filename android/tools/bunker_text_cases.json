{
  "_": "What every implementation of Bunker's text does (bunker_text.py, BunkerText.java, and the iOS launcher's): run by test_bunker_text.SharedCases and test_bunker_text_java. Each case: the pack's language and texts, a call, what it gives.",
  "english": {
    "test.hello": "Hello {name}",
    "test.braces": "{{literal}} {n}",
    "test.file.one": "{n} file",
    "test.file.other": "{n} files",
    "test.left.one": "{n} file left in {place}",
    "test.left.other": "{n} files left in {place}",
    "test.around": "Allow up to {select} pieces.",
    "test.around_named": "{name} gets {select} now"
  },
  "cases": [
    {"name": "English without a pack", "language": "en", "translation": {}, "call": "t", "key": "test.hello", "params": {"name": "Ana"}, "expect": "Hello Ana"},
    {"name": "the translation", "language": "de", "translation": {"test.hello": "Hallo {name}"}, "call": "t", "key": "test.hello", "params": {"name": "Ana"}, "expect": "Hallo Ana"},
    {"name": "a placeholder dropped: English", "language": "de", "translation": {"test.hello": "Hallo"}, "call": "t", "key": "test.hello", "params": {"name": "Ana"}, "expect": "Hello Ana"},
    {"name": "a placeholder added: English", "language": "de", "translation": {"test.hello": "Hallo {name} {x}"}, "call": "t", "key": "test.hello", "params": {"name": "Ana"}, "expect": "Hello Ana"},
    {"name": "a format spec added: English", "language": "de", "translation": {"test.hello": "Hallo {name:>99999}"}, "call": "t", "key": "test.hello", "params": {"name": "Ana"}, "expect": "Hello Ana"},
    {"name": "a conversion added: English", "language": "de", "translation": {"test.hello": "Hallo {name!r}"}, "call": "t", "key": "test.hello", "params": {"name": "Ana"}, "expect": "Hello Ana"},
    {"name": "a positional placeholder: English", "language": "de", "translation": {"test.hello": "Hallo {} {name}"}, "call": "t", "key": "test.hello", "params": {"name": "Ana"}, "expect": "Hello Ana"},
    {"name": "an unclosed brace: English", "language": "de", "translation": {"test.hello": "Hallo {name"}, "call": "t", "key": "test.hello", "params": {"name": "Ana"}, "expect": "Hello Ana"},
    {"name": "a stray closing brace: English", "language": "de", "translation": {"test.hello": "Hallo } {name}"}, "call": "t", "key": "test.hello", "params": {"name": "Ana"}, "expect": "Hello Ana"},
    {"name": "an empty translation: English", "language": "de", "translation": {"test.hello": ""}, "call": "t", "key": "test.hello", "params": {"name": "Ana"}, "expect": "Hello Ana"},
    {"name": "an unknown key: the key", "language": "en", "translation": {}, "call": "t", "key": "test.nope", "params": {}, "expect": "test.nope"},
    {"name": "an unknown key with something to show instead", "language": "en", "translation": {}, "call": "t_or", "key": "test.nope", "fallback": "ice", "params": {}, "expect": "ice"},
    {"name": "a known key ignores the fallback", "language": "en", "translation": {}, "call": "t_or", "key": "test.hello", "fallback": "ice", "params": {"name": "Ana"}, "expect": "Hello Ana"},
    {"name": "doubled braces are braces", "language": "en", "translation": {}, "call": "t", "key": "test.braces", "params": {"n": "3"}, "expect": "{literal} 3"},
    {"name": "doubled braces in a translation", "language": "de", "translation": {"test.braces": "{{wörtlich}} {n}"}, "call": "t", "key": "test.braces", "params": {"n": "3"}, "expect": "{wörtlich} 3"},
    {"name": "a value missing: the English as it is", "language": "en", "translation": {}, "call": "t", "key": "test.hello", "params": {}, "expect": "Hello {name}"},
    {"name": "a value missing in a translation: the English as it is", "language": "de", "translation": {"test.hello": "Hallo {name}"}, "call": "t", "key": "test.hello", "params": {}, "expect": "Hello {name}"},
    {"name": "values are not formatted again", "language": "en", "translation": {}, "call": "t", "key": "test.hello", "params": {"name": "{x} 50%"}, "expect": "Hello {x} 50%"},

    {"name": "English one", "language": "en", "translation": {}, "call": "count", "key": "test.file", "n": 1, "params": {}, "expect": "1 file"},
    {"name": "English other", "language": "en", "translation": {}, "call": "count", "key": "test.file", "n": 2, "params": {}, "expect": "2 files"},
    {"name": "English zero is other", "language": "en", "translation": {}, "call": "count", "key": "test.file", "n": 0, "params": {}, "expect": "0 files"},
    {"name": "the count written the language's way", "language": "en", "translation": {}, "call": "count", "key": "test.file", "n": 1200, "params": {}, "expect": "1,200 files"},
    {"name": "German count", "language": "de", "translation": {"test.file.one": "{n} Datei", "test.file.other": "{n} Dateien"}, "call": "count", "key": "test.file", "n": 1200, "params": {}, "expect": "1.200 Dateien"},
    {"name": "Polish one", "language": "pl", "translation": {"test.file.one": "{n} plik", "test.file.few": "{n} pliki", "test.file.many": "{n} plików", "test.file.other": "{n} pliku"}, "call": "count", "key": "test.file", "n": 1, "params": {}, "expect": "1 plik"},
    {"name": "Polish few", "language": "pl", "translation": {"test.file.one": "{n} plik", "test.file.few": "{n} pliki", "test.file.many": "{n} plików", "test.file.other": "{n} pliku"}, "call": "count", "key": "test.file", "n": 3, "params": {}, "expect": "3 pliki"},
    {"name": "Polish many", "language": "pl", "translation": {"test.file.one": "{n} plik", "test.file.few": "{n} pliki", "test.file.many": "{n} plików", "test.file.other": "{n} pliku"}, "call": "count", "key": "test.file", "n": 5, "params": {}, "expect": "5 plików"},
    {"name": "Polish 22 is few", "language": "pl", "translation": {"test.file.one": "{n} plik", "test.file.few": "{n} pliki", "test.file.many": "{n} plików", "test.file.other": "{n} pliku"}, "call": "count", "key": "test.file", "n": 22, "params": {}, "expect": "22 pliki"},
    {"name": "Polish without many: English for every count", "language": "pl", "translation": {"test.file.one": "{n} plik", "test.file.few": "{n} pliki", "test.file.other": "{n} pliku"}, "call": "count", "key": "test.file", "n": 3, "params": {}, "expect": "3 files"},
    {"name": "Czech needs no many for whole numbers", "language": "cs", "translation": {"test.file.one": "{n} soubor", "test.file.few": "{n} soubory", "test.file.other": "{n} souborů"}, "call": "count", "key": "test.file", "n": 5, "params": {}, "expect": "5 souborů"},
    {"name": "Japanese has only other", "language": "ja", "translation": {"test.file.other": "{n} ファイル"}, "call": "count", "key": "test.file", "n": 1, "params": {}, "expect": "1 ファイル"},
    {"name": "French 0 is one", "language": "fr", "translation": {"test.file.one": "{n} fichier", "test.file.other": "{n} fichiers"}, "call": "count", "key": "test.file", "n": 0, "params": {}, "expect": "0 fichier"},
    {"name": "a form may leave out the count", "language": "pl", "translation": {"test.file.one": "jeden plik", "test.file.few": "{n} pliki", "test.file.many": "{n} plików", "test.file.other": "{n} pliku"}, "call": "count", "key": "test.file", "n": 1, "params": {}, "expect": "jeden plik"},
    {"name": "a form adding a placeholder: English", "language": "de", "translation": {"test.file.one": "{n} Datei {x}", "test.file.other": "{n} Dateien"}, "call": "count", "key": "test.file", "n": 2, "params": {}, "expect": "2 files"},
    {"name": "a count with other values", "language": "de", "translation": {"test.left.one": "{n} Datei übrig in {place}", "test.left.other": "{n} Dateien übrig in {place}"}, "call": "count", "key": "test.left", "n": 2, "params": {"place": "Köln"}, "expect": "2 Dateien übrig in Köln"},
    {"name": "an unknown counted key", "language": "en", "translation": {}, "call": "count", "key": "test.nope", "n": 2, "params": {}, "expect": "test.nope.other"},

    {"name": "around a control", "language": "en", "translation": {}, "call": "around", "key": "test.around", "slot": "select", "params": {}, "expect": ["Allow up to ", " pieces."]},
    {"name": "around, translated", "language": "de", "translation": {"test.around": "Bis zu {select} Teile."}, "call": "around", "key": "test.around", "slot": "select", "params": {}, "expect": ["Bis zu ", " Teile."]},
    {"name": "around, the slot dropped: English", "language": "de", "translation": {"test.around": "Teile."}, "call": "around", "key": "test.around", "slot": "select", "params": {}, "expect": ["Allow up to ", " pieces."]},
    {"name": "around, the slot twice: English", "language": "de", "translation": {"test.around": "{select} Teile {select}"}, "call": "around", "key": "test.around", "slot": "select", "params": {}, "expect": ["Allow up to ", " pieces."]},
    {"name": "around with values", "language": "de", "translation": {"test.around_named": "{name} bekommt jetzt {select}"}, "call": "around", "key": "test.around_named", "slot": "select", "params": {"name": "Ana"}, "expect": ["Ana bekommt jetzt ", ""]}
  ]
}
